{
    "name": "@ts-core/oauth",
    "version": "3.1.20",
    "description": "TypeScript library for OAuth authentication through Google, VK, Yandex, Mail.ru, Keycloak and Telegram, supporting browser, Cordova and Telegram Web App platforms",
    "main": "./cjs/public-api.js",
    "module": "./esm/public-api.js",
    "exports": {
        ".": {
            "import": "./esm/public-api.js",
            "require": "./cjs/public-api.js"
        }
    },
    "scripts": {},
    "author": {
        "name": "Renat Gubaev",
        "email": "renat.gubaev@gmail.com"
    },
    "license": "ISC",
    "dependencies": {
        "@ts-core/common": "~3.0.43"
    },
    "devDependencies": {
        "@types/node": "^14.14.31",
        "gulp-npm-module-publisher": "^3.0.2"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/ManhattanDoctor/ts-core-oauth.git"
    },
    "keywords": [
        "typescript",
        "oauth",
        "oauth2",
        "authentication",
        "authorization",
        "google",
        "vk",
        "yandex",
        "mailru",
        "keycloak",
        "telegram",
        "cordova",
        "login",
        "sso"
    ],
    "bugs": {
        "url": "https://github.com/ManhattanDoctor/ts-core-oauth/issues"
    },
    "homepage": "https://github.com/ManhattanDoctor/ts-core-oauth#readme"
}
